[Unit]
Description=waze-on-cluster simple HUD control socket

[Socket]
# The iDrive app connects here, which starts waze-on-cluster-hud.service.
# Every OAP app process has tm_oap_app as a supplementary group.
ListenStream=/dev/shm/waze-on-cluster/hud.sock
DirectoryMode=0755
SocketMode=0660
SocketGroup=tm_oap_app

[Install]
WantedBy=sockets.target
